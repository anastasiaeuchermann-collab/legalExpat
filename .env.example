# =============================================
# DATABASE (SUPABASE)
# =============================================
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to use in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key (NEVER expose to browser - server only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct database connection URL (optional, for migrations)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# =============================================
# AUTHENTICATION (NEXTAUTH)
# =============================================
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_minimum_32_characters_long

# URL where your app is hosted
NEXTAUTH_URL=http://localhost:3000

# In production, set to your domain:
# NEXTAUTH_URL=https://yourdomain.com

# =============================================
# PAYMENTS (STRIPE)
# =============================================
# Get these from: https://dashboard.stripe.com/apikeys

# Stripe publishable key (safe to use in browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe secret key (NEVER expose to browser - server only)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe webhook secret (for verifying webhook signatures)
# Get this after creating a webhook endpoint in Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe API version (optional, defaults to latest)
STRIPE_API_VERSION=2024-11-20.acacia

# =============================================
# APPLICATION SETTINGS
# =============================================
# Public URL for your application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application environment
NODE_ENV=development

# Enable debug logging (optional)
DEBUG=false

# =============================================
# EMAIL (OPTIONAL - FOR NOTIFICATIONS)
# =============================================
# Email provider settings (e.g., SendGrid, Resend, AWS SES)
# EMAIL_FROM=noreply@legalexpat.com
# EMAIL_SERVER_HOST=smtp.sendgrid.net
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=apikey
# EMAIL_SERVER_PASSWORD=your_sendgrid_api_key

# =============================================
# FILE STORAGE (SUPABASE STORAGE)
# =============================================
# Supabase storage bucket names (create these in Supabase dashboard)
NEXT_PUBLIC_AVATARS_BUCKET=avatars
NEXT_PUBLIC_DOCUMENTS_BUCKET=documents
NEXT_PUBLIC_ATTACHMENTS_BUCKET=attachments

# Maximum file upload size in bytes (default: 5MB)
MAX_FILE_UPLOAD_SIZE=5242880

# =============================================
# RATE LIMITING (OPTIONAL)
# =============================================
# API rate limit (requests per minute)
API_RATE_LIMIT=60

# =============================================
# ANALYTICS (OPTIONAL)
# =============================================
# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog (optional)
# NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# =============================================
# DEVELOPMENT TOOLS
# =============================================
# Seed database on startup (development only)
SEED_DATABASE=false

# Enable Supabase local development
# SUPABASE_LOCAL=true
